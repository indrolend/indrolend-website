# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Development mode (set to 'production' when deploying)
NODE_ENV=development

# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_ARTIST_ID=59X3431NBfd6xWMc3Zlh0v

# Apple Music API Credentials
# Get these from: https://developer.apple.com/
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# TikTok API Credentials
# Get these from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_USERNAME=indrolend

# Website Analytics Provider
# Options: 'cloudflare', 'google', 'plausible'
ANALYTICS_PROVIDER=cloudflare

# Cloudflare Analytics (if using Cloudflare)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# Google Analytics (if using Google Analytics)
GOOGLE_ANALYTICS_PROPERTY_ID=your_ga_property_id
GOOGLE_SERVICE_ACCOUNT_KEY=your_service_account_json

# Plausible Analytics (if using Plausible)
PLAUSIBLE_API_KEY=your_plausible_api_key
PLAUSIBLE_SITE_ID=yourdomain.com
